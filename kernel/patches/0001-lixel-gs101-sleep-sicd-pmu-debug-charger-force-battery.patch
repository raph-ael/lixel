+/*
+ * gs101 system sleep.
+ *
+ * PSCI SYSTEM_SUSPEND alone is not enough on gs101: like for the CPU idle
+ * states, ACPM (the "flexpmu" firmware on the APM core) decides what the
+ * SoC does from the hint in the last CPU's CPU_INFORM register, and only
+ * wakes the SoC up for the sources enabled in WAKEUP_INT_EN. Without the
+ * SLEEP hint and the wake-up mask the SoC either does not power down or
+ * never comes back. The sequences below are what Google's vendor kernel
+ * runs around SYSTEM_SUSPEND (cal_pm_enter/exit(SYS_SLEEP)).
+ */
+enum gs101_seq_type {
+	GS101_SEQ_WRITE,
+	GS101_SEQ_COND_WRITE,
+	GS101_SEQ_CLEAR_PEND,
+	GS101_SEQ_SET_BIT_ATOMIC,
+	GS101_SEQ_CHECK_SKIP,
+	GS101_SEQ_WAIT,
+};
+
+struct gs101_seq {
+	u8 type;
+	u32 addr;
+	u32 mask;
+	u32 val;
+	u32 cond_addr;
+	u32 cond_mask;
+	u32 cond_val;
+	u32 unused;
+};
+
+#include "gs101-sleep-seq.h"
+
+#define GS101_PMU_BASE			0x17460000
+#define GS101_PMU_INTR_GEN_BASE		0x17470000
+#define GS101_CPU_INFORM_SLEEP		4
+/* RTC, TRTC, EINT, EINT_FAR, MAILBOX_AOC2AP, USB_REWA */
+#define GS101_WAKEUP_INT_EN_SLEEP	0x000100bf
+#define GS101_SEQ_MAX_MAPS		40
+
+struct gs101_seq_map {
+	u32 base;
+	void __iomem *va;
+};
+
+static struct gs101_seq_map gs101_seq_maps[GS101_SEQ_MAX_MAPS];
+static bool gs101_sleep_ready;
+static bool gs101_sleep_entered;
+static u32 gs101_wakeup_stat[2];
+
+static bool gs101_sleep_seq = true;
+module_param_named(sleep_seq, gs101_sleep_seq, bool, 0644);
+static uint gs101_sleep_wakeup_en = GS101_WAKEUP_INT_EN_SLEEP;
+module_param_named(sleep_wakeup_en, gs101_sleep_wakeup_en, uint, 0644);
+static uint gs101_sleep_hint = GS101_CPU_INFORM_SLEEP;
+module_param_named(sleep_hint, gs101_sleep_hint, uint, 0644);
+/* 0: exit sequence, 1: early wake-up sequence, 2: decide from ACPM counter */
+static uint gs101_sleep_exit_mode = 2;
+module_param_named(sleep_exit_mode, gs101_sleep_exit_mode, uint, 0644);
+
+static void __iomem *gs101_flexpmu_dbg;
+static u32 gs101_apsoc_cnt_prev;
+
+/* ACPM flexpmu debug area: 16-byte lines, data at +8 */
+#define FLEXPMU_LINE(n)			((n) * 16 + 8)
+#define FLEXPMU_AP_COUNT_SLEEP		22
+#define FLEXPMU_MIF_COUNT_SLEEP		23
+#define FLEXPMU_AP_COUNT_SICD		24
+#define FLEXPMU_MIF_COUNT_SICD		25
+
+static u32 gs101_flexpmu_read(unsigned int line, unsigned int word)
+{
+	if (!gs101_flexpmu_dbg)
+		return 0;
+	return readl(gs101_flexpmu_dbg + FLEXPMU_LINE(line) + word * 4);
+}
+
+static void __iomem *gs101_seq_va(u32 addr)
+{
+	u32 base = addr & ~0xffffU;
+	int i;
+
+	for (i = 0; i < GS101_SEQ_MAX_MAPS; i++) {
+		if (gs101_seq_maps[i].base == base)
+			return gs101_seq_maps[i].va + (addr & 0xffff);
+	}
+	return NULL;
+}
+
+static int gs101_seq_map_one(u32 addr)
+{
+	u32 base = addr & ~0xffffU;
+	int i;
+
+	if (!addr || base == GS101_PMU_BASE || base == GS101_PMU_INTR_GEN_BASE)
+		return 0;
+
+	for (i = 0; i < GS101_SEQ_MAX_MAPS; i++) {
+		if (gs101_seq_maps[i].base == base)
+			return 0;
+		if (!gs101_seq_maps[i].base) {
+			gs101_seq_maps[i].va = ioremap(base, 0x10000);
+			if (!gs101_seq_maps[i].va)
+				return -ENOMEM;
+			gs101_seq_maps[i].base = base;
+			return 0;
+		}
+	}
+	return -ENOSPC;
+}
+
+static int gs101_seq_map(const struct gs101_seq *seq, unsigned int n)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < n; i++) {
+		ret = gs101_seq_map_one(seq[i].addr);
+		if (!ret)
+			ret = gs101_seq_map_one(seq[i].cond_addr);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static u32 gs101_seq_read(u32 addr)
+{
+	u32 base = addr & ~0xffffU, val = 0;
+	void __iomem *va;
+
+	if (base == GS101_PMU_BASE) {
+		val = pmu_raw_readl(addr & 0xffff);
+	} else if (base == GS101_PMU_INTR_GEN_BASE) {
+		regmap_read(pmu_context->pmuintrgen, addr & 0xffff, &val);
+	} else {
+		va = gs101_seq_va(addr);
+		if (va)
+			val = readl(va);
+	}
+	return val;
+}
+
+static void gs101_seq_write(u32 addr, u32 mask, u32 val)
+{
+	u32 base = addr & ~0xffffU;
+	void __iomem *va;
+
+	if (base == GS101_PMU_BASE) {
+		if (mask == U32_MAX)
+			tensor_sec_reg_write((void *)(uintptr_t)GS101_PMU_BASE,
+					     addr & 0xffff, val);
+		else
+			tensor_sec_update_bits((void *)(uintptr_t)GS101_PMU_BASE,
+					       addr & 0xffff, mask, val);
+	} else if (base == GS101_PMU_INTR_GEN_BASE) {
+		if (mask == U32_MAX)
+			regmap_write(pmu_context->pmuintrgen, addr & 0xffff, val);
+		else
+			regmap_update_bits(pmu_context->pmuintrgen,
+					   addr & 0xffff, mask, val);
+	} else {
+		va = gs101_seq_va(addr);
+		if (!va)
+			return;
+		if (mask != U32_MAX)
+			val = (readl(va) & ~mask) | (val & mask);
+		writel(val, va);
+	}
+}
+
+static void gs101_seq_run(const struct gs101_seq *seq, unsigned int n)
+{
+	bool skip = false;
+	unsigned int i, t;
+
+	for (i = 0; i < n; i++) {
+		const struct gs101_seq *e = &seq[i];
+		bool cond = !e->cond_addr ||
+			(gs101_seq_read(e->cond_addr) & e->cond_mask) == e->cond_val;
+
+		if (skip) {
+			skip = false;
+			continue;
+		}
+
+		switch (e->type) {
+		case GS101_SEQ_WRITE:
+			gs101_seq_write(e->addr, e->mask, e->val);
+			break;
+		case GS101_SEQ_COND_WRITE:
+			if (cond)
+				gs101_seq_write(e->addr, e->mask, e->val);
+			break;
+		case GS101_SEQ_CLEAR_PEND:
+			gs101_seq_write(e->addr, U32_MAX,
+					gs101_seq_read(e->cond_addr) &
+					e->cond_mask & e->mask);
+			break;
+		case GS101_SEQ_SET_BIT_ATOMIC:
+			/* the value is the bit number */
+			tensor_sec_reg_write((void *)(uintptr_t)GS101_PMU_BASE,
+					     (e->addr & 0xffff) | 0xc000, e->val);
+			break;
+		case GS101_SEQ_CHECK_SKIP:
+			skip = (gs101_seq_read(e->addr) & e->mask) == e->val;
+			break;
+		case GS101_SEQ_WAIT:
+			if (!cond)
+				break;
+			for (t = 0; t < 5000; t++) {
+				if ((gs101_seq_read(e->addr) & e->mask) == e->val)
+					break;
+				udelay(1);
+			}
+			if (t == 5000)
+				pr_err("gs101-sleep: wait timed out at %#x\n",
+				       e->addr);
+			break;
+		}
+	}
+}
+
+/*
+ * SICD ("system idle clock down"): when the last CPU goes idle with the SICD
+ * hint, ACPM takes the whole SoC down behind it (PLLs, buses, and the memory
+ * interface when nothing else holds it) and brings it back on any wake-up
+ * source enabled in WAKEUP_INT_EN. The vendor kernel uses it from cpuidle
+ * whenever no "idle IP" is busy. Here it is used in suspend-to-idle, where
+ * all devices are suspended anyway (sicd=1), or always (sicd=2, experimental).
+ */
+#define GS101_CPU_INFORM_SICD		3
+#define GS101_WAKEUP_INT_EN_SICD	0x7f8f00ff
+#define GS101_WAKEUP2_INT_EN_SICD	0x0000000c
+
+static uint gs101_sicd_mode;
+module_param_named(sicd, gs101_sicd_mode, uint, 0644);
+static uint gs101_sicd_wakeup_en = GS101_WAKEUP_INT_EN_SICD;
+module_param_named(sicd_wakeup_en, gs101_sicd_wakeup_en, uint, 0644);
+static uint gs101_sicd_count;
+module_param_named(sicd_count, gs101_sicd_count, uint, 0444);
+static uint gs101_sicd_early;
+module_param_named(sicd_early, gs101_sicd_early, uint, 0444);
+
+static struct cpumask gs101_idle_cpus;
+static bool gs101_in_s2idle;
+static bool gs101_sicd_entered;
+static u32 gs101_sicd_cnt_prev;
+/* wake-up reasons seen when leaving SICD: [0] completed, [1] aborted */
+static u32 gs101_sicd_ws_hist[2][2][32];
+static u32 gs101_sicd_ws_last[2][2];
+
+/* Called with cpupm_lock held and IRQs off, after the C2 hint was set */
+static void gs101_sicd_enter(unsigned int cpu)
+{
+	cpumask_set_cpu(cpu, &gs101_idle_cpus);
+
+	if (!gs101_sicd_mode || !gs101_flexpmu_dbg || !gs101_sleep_ready)
+		return;
+	if (gs101_sicd_mode == 1 && !gs101_in_s2idle)
+		return;
+	if (!bitmap_empty(pmu_context->in_cpuhp, num_possible_cpus()))
+		return;
+	if (!cpumask_equal(&gs101_idle_cpus, cpu_online_mask))
+		return;
+
+	gs101_sicd_cnt_prev = gs101_flexpmu_read(FLEXPMU_AP_COUNT_SICD, 1);
+	regmap_write(pmu_context->pmureg, GS101_CPU_INFORM(cpu),
+		     GS101_CPU_INFORM_SICD);
+	regmap_write(pmu_context->pmureg, GS101_WAKEUP_STAT, 0);
+	regmap_write(pmu_context->pmureg, GS101_TOP_INT_EN,
+		     gs101_sicd_wakeup_en);
+	regmap_write(pmu_context->pmureg, GS101_WAKEUP2_STAT, 0);
+	regmap_write(pmu_context->pmureg, GS101_WAKEUP2_INT_EN,
+		     GS101_WAKEUP2_INT_EN_SICD);
+	gs101_sicd_entered = true;
+}
+
+/* Called with cpupm_lock held and IRQs off, by every CPU leaving idle */
+static void gs101_sicd_exit(unsigned int cpu)
+{
+	unsigned int r, b;
+	bool early;
+
+	cpumask_clear_cpu(cpu, &gs101_idle_cpus);
+
+	if (!gs101_sicd_entered)
+		return;
+	gs101_sicd_entered = false;
+
+	early = gs101_flexpmu_read(FLEXPMU_AP_COUNT_SICD, 1) == gs101_sicd_cnt_prev;
+	for (r = 0; r < 2; r++) {
+		u32 ws = pmu_raw_readl(r ? GS101_WAKEUP2_STAT : GS101_WAKEUP_STAT);
+
+		gs101_sicd_ws_last[early][r] = ws;
+		for (b = 0; b < 32; b++)
+			if (ws & BIT(b))
+				gs101_sicd_ws_hist[early][r][b]++;
+	}
+
+	if (early) {
+		gs101_sicd_early++;
+		gs101_seq_run(gs101_earlywkup_sicd,
+			      ARRAY_SIZE(gs101_earlywkup_sicd));
+	} else {
+		gs101_sicd_count++;
+		gs101_seq_run(gs101_exit_sicd, ARRAY_SIZE(gs101_exit_sicd));
+	}
+}
+
+static int gs101_sleep_syscore_suspend(void *data)
+{
+	unsigned int cpu = smp_processor_id();
+
+	gs101_sleep_entered = false;
+	if (!gs101_sleep_ready || !gs101_sleep_seq ||
+	    pm_suspend_target_state != PM_SUSPEND_MEM)
+		return 0;
+
+	gs101_apsoc_cnt_prev = gs101_flexpmu_read(FLEXPMU_AP_COUNT_SLEEP, 1);
+
+	regmap_write(pmu_context->pmureg, GS101_WAKEUP_STAT, 0);
+	regmap_write(pmu_context->pmureg, GS101_TOP_INT_EN,
+		     gs101_sleep_wakeup_en);
+	regmap_write(pmu_context->pmureg, GS101_WAKEUP2_STAT, 0);
+	regmap_write(pmu_context->pmureg, GS101_WAKEUP2_INT_EN, 0);
+
+	regmap_write(pmu_context->pmureg, GS101_CPU_INFORM(cpu),
+		     gs101_sleep_hint);
+	gs101_seq_run(gs101_enter_sleep, ARRAY_SIZE(gs101_enter_sleep));
+	gs101_sleep_entered = true;
+
+	return 0;
+}
+
+static void gs101_sleep_syscore_resume(void *data)
+{
+	bool early;
+	u32 cnt;
+
+	if (!gs101_sleep_entered)
+		return;
+	gs101_sleep_entered = false;
+
+	gs101_wakeup_stat[0] = pmu_raw_readl(GS101_WAKEUP_STAT);
+	gs101_wakeup_stat[1] = pmu_raw_readl(GS101_WAKEUP2_STAT);
+	cnt = gs101_flexpmu_read(FLEXPMU_AP_COUNT_SLEEP, 1);
+
+	if (gs101_sleep_exit_mode == 2)
+		early = gs101_flexpmu_dbg && cnt == gs101_apsoc_cnt_prev;
+	else
+		early = gs101_sleep_exit_mode == 1;
+
+	if (early)
+		gs101_seq_run(gs101_earlywkup_sleep,
+			      ARRAY_SIZE(gs101_earlywkup_sleep));
+	else
+		gs101_seq_run(gs101_exit_sleep, ARRAY_SIZE(gs101_exit_sleep));
+
+	pr_info("gs101-sleep: %s, wakeup_stat %#x %#x, apsoc sleep count %u -> %u\n",
+		early ? "early wake-up" : "woke up", gs101_wakeup_stat[0],
+		gs101_wakeup_stat[1], gs101_apsoc_cnt_prev, cnt);
+}
+
+static const struct syscore_ops gs101_sleep_syscore_ops = {
+	.suspend = gs101_sleep_syscore_suspend,
+	.resume = gs101_sleep_syscore_resume,
+};
+
+static struct syscore gs101_sleep_syscore = {
+	.ops = &gs101_sleep_syscore_ops,
+};
+
+/*
+ * Find ACPM's FLEXPMU_DBG buffer: a struct plugin_buffer { u32 size, address,
+ * next; char name[12]; } somewhere in the APM SRAM.
+ */
+#define GS101_APM_SRAM_BASE	0x02039000
+#define GS101_APM_SRAM_SIZE	0x40000
+#define GS101_APM_INITDATA	0xa000
+
+static int gs101_flexpmu_find(void)
+{
+	void __iomem *sram;
+	u32 plugins, nplugins, i, n, addr = 0;
+
+	if (gs101_flexpmu_dbg)
+		return 0;
+
+	sram = ioremap(GS101_APM_SRAM_BASE, GS101_APM_SRAM_SIZE);
+	if (!sram)
+		return -ENOMEM;
+
+	/*
+	 * struct acpm_framework at initdata: { u32 plugins, num_plugins, ... };
+	 * struct plugin is 48 bytes with plugin_ops at +12; struct plugin_ops
+	 * has its build_info at +16 and the buffer list head at +68.
+	 * Only these are read: parts of the SRAM abort on access.
+	 */
+	plugins = readl(sram + GS101_APM_INITDATA);
+	nplugins = readl(sram + GS101_APM_INITDATA + 4);
+	if (plugins >= GS101_APM_SRAM_SIZE || nplugins > 32)
+		nplugins = 0;
+
+	for (i = 0; i < nplugins && !addr; i++) {
+		u32 ops, buf;
+
+		if (plugins + i * 48 + 48 > GS101_APM_SRAM_SIZE)
+			break;
+		ops = readl(sram + plugins + i * 48 + 12);
+		if (!ops || ops + 72 > GS101_APM_SRAM_SIZE)
+			continue;
+		/* build_version[47] must be 0 and major >= 1 */
+		if (readb(sram + ops + 16 + 47) || readb(sram + ops + 16 + 48) < 1)
+			continue;
+
+		buf = readl(sram + ops + 68);
+		for (n = 0; buf && buf + 24 <= GS101_APM_SRAM_SIZE && n < 32; n++) {
+			if (readl(sram + buf + 12) == 0x58454c46 &&	/* "FLEX" */
+			    readl(sram + buf + 16) == 0x5f554d50 &&	/* "PMU_" */
+			    (readl(sram + buf + 20) & 0xffffff) == 0x474244) { /* "DBG" */
+				addr = readl(sram + buf + 4);
+				break;
+			}
+			buf = readl(sram + buf + 8);
+		}
+	}
+
+	if (!addr || addr >= GS101_APM_SRAM_SIZE - 0x400) {
+		iounmap(sram);
+		return -ENOENT;
+	}
+

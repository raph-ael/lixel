+static void gs101_sleep_init(struct device *dev)
+{
+	struct dentry *dir;
+	int ret;
+
+	if (!pmu_context->pmuintrgen)
+		return;
+
+	ret = gs101_seq_map(gs101_enter_sleep, ARRAY_SIZE(gs101_enter_sleep));
+	if (!ret)
+		ret = gs101_seq_map(gs101_exit_sleep,
+				    ARRAY_SIZE(gs101_exit_sleep));
+	if (!ret)
+		ret = gs101_seq_map(gs101_earlywkup_sleep,
+				    ARRAY_SIZE(gs101_earlywkup_sleep));
+	if (!ret)
+		ret = gs101_seq_map(gs101_exit_sicd, ARRAY_SIZE(gs101_exit_sicd));
+	if (!ret)
+		ret = gs101_seq_map(gs101_earlywkup_sicd,
+				    ARRAY_SIZE(gs101_earlywkup_sicd));
+	if (ret) {
+		dev_warn(dev, "gs101 sleep sequences unavailable: %d\n", ret);
+		return;
+	}
+
+	register_syscore(&gs101_sleep_syscore);
+	gs101_sleep_ready = true;
+
+	dir = debugfs_create_dir("gs101-pmu", NULL);
+	debugfs_create_file("flexpmu", 0400, dir, NULL, &gs101_flexpmu_fops);
+	debugfs_create_file("regs", 0400, dir, NULL, &gs101_pmu_regs_fops);
+	debugfs_create_file("blk", 0200, dir, NULL, &gs101_blk_fops);
+}

+/*
+ * Switch a sub-block's power domain: "echo 'MFC 0' > blk". ACPM runs the
+ * actual sequence once CONFIGURATION changes. Experimental: nothing checks
+ * that no driver still uses the block.
+ */
+static ssize_t gs101_blk_write(struct file *file, const char __user *ubuf,
+			       size_t count, loff_t *ppos)
+{
+	char buf[32], name[16];
+	unsigned int i, on, t;
+
+	if (count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	buf[count] = 0;
+	if (sscanf(buf, "%15s %u", name, &on) != 2)
+		return -EINVAL;
+
+	for (i = 0; i < ARRAY_SIZE(gs101_blks); i++) {
+		u32 off = gs101_blks[i].off;
+
+		if (strcmp(name, gs101_blks[i].name))
+			continue;
+		regmap_update_bits(pmu_context->pmureg,
+				   GS101_SUBBLK_CONFIGURATION(off), 1, !!on);
+		for (t = 0; t < 20000; t++) {
+			if ((pmu_raw_readl(GS101_SUBBLK_STATUS(off)) & 1) == !!on)
+				return count;
+			udelay(10);
+		}
+		return -ETIMEDOUT;
+	}
+	return -ENOENT;
+}
+
+static const struct file_operations gs101_blk_fops = {

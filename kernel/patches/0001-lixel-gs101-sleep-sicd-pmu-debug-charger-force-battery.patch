+		{ "EINT_WAKEUP_MASK", GS101_EINT_WAKEUP_MASK },
+		{ "EINT_WAKEUP_MASK2", GS101_EINT_WAKEUP_MASK2 },
+		{ "EINT_WAKEUP_MASK3", GS101_EINT_WAKEUP_MASK3 },
+		{ "TOP_OUT", GS101_TOP_OUT },
+		{ "SYSTEM_CTRL", GS101_SYSTEM_CTRL },
+		{ "IDLE_IP0", 0x3e0 }, { "IDLE_IP1", 0x3e4 },
+		{ "IDLE_IP2", 0x3e8 }, { "IDLE_IP3", 0x3ec },
+		{ "IDLE_IP0_MASK", 0x3f0 }, { "IDLE_IP1_MASK", 0x3f4 },
+		{ "IDLE_IP2_MASK", 0x3f8 }, { "IDLE_IP3_MASK", 0x3fc },
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(regs); i++)
+		seq_printf(m, "%-18s %04x %08x\n", regs[i].name, regs[i].off,
+			   pmu_raw_readl(regs[i].off));
+	for (i = 0; i < 8; i++)
+		seq_printf(m, "CPU_INFORM%u        %04x %08x\n", i,
+			   GS101_CPU_INFORM(i), pmu_raw_readl(GS101_CPU_INFORM(i)));
+	/* power state of every sub-block */
+	for (i = 0; i < ARRAY_SIZE(gs101_blks); i++)
+		seq_printf(m, "blk %-8s %04x conf %08x status %08x states %08x\n",
+			   gs101_blks[i].name, gs101_blks[i].off,
+			   pmu_raw_readl(GS101_SUBBLK_CONFIGURATION(gs101_blks[i].off)),
+			   pmu_raw_readl(GS101_SUBBLK_STATUS(gs101_blks[i].off)),
+			   pmu_raw_readl(GS101_SUBBLK_STATES(gs101_blks[i].off)));
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(gs101_pmu_regs);

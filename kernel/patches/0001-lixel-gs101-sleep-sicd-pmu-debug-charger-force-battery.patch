+		for (b = 0; b < 32; b++)
+			if (gs101_sicd_ws_hist[i / 2][i % 2][b])
+				seq_printf(m, " %u:%u", b,
+					   gs101_sicd_ws_hist[i / 2][i % 2][b]);
+		seq_puts(m, "\n");
+	}
+	for (i = 0; i < 43; i++)
+		seq_printf(m, "line%02u %08x %08x\n", i,
+			   gs101_flexpmu_read(i, 0), gs101_flexpmu_read(i, 1));
